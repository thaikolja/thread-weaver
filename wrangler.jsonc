{
  "$schema":            "./node_modules/wrangler/config-schema.json",
  "name":               "thread-weaver",
  "compatibility_date": "2026-11-03",
  "workers_dev":        true,
  "preview_urls":       true,
  "routes":             [
    {
      "pattern":       "thread-weaver.kolja.codes",
      "custom_domain": true
    }
  ],
  "assets":             {
    "directory":          "./.output/public",
    "html_handling":      "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
