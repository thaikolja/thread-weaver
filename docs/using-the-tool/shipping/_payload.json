d","Download",[95,156,157,158,161,162,165],{},"Download .md saves ",[127,159,160],{},"thread-\u003Cplatform>-\u003Ctimestamp>.md",". Each post is a ",[127,163,164],{},"### Post N"," section, joined the same way as copy-all.",[99,167,169],{"id":168},"listen-and-qr","Listen and QR",[95,171,172],{},"Listen speaks the published post at rate 1.05. Clicking the same card again stops it. Send to Phone opens a QR for that post. Closing the draft, or editing it, closes the QR as well.",{"title":174,"searchDepth":175,"depth":175,"links":176},"",2,[177,178,179,180],{"id":101,"depth":175,"text":102},{"id":139,"depth":175,"text":140},{"id":153,"depth":175,"text":154},{"id":168,"depth":175,"text":169},"Copy, download, listen, and send.","md",null,{},true,{"title":40,"description":181},"jb3M7iEIEf5wjdxyxPWLnDly3u6MhneD78OTfD2ci6M",[189,191],{"title":36,"path":37,"stem":38,"description":190,"children":-1},"Capitalize posts, finish sentences, and keep line breaks.",{"title":49,"path":50,"stem":51,"description":192,"children":-1},"Where the rules live, and where the browser calls live.",1792868107566]