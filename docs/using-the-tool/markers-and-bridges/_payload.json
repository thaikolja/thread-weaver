id":181},"placement","Placement",[104,184,185,194],{},[107,186,187],{},[110,188,189,191],{},[113,190,182],{},[113,192,193],{},"Result",[120,195,196,204,212,220],{},[110,197,198,201],{},[125,199,200],{},"New line (bottom)",[125,202,203],{},"The marker sits under the text. A bridge gets its own paragraph.",[110,205,206,209],{},[125,207,208],{},"Header (top)",[125,210,211],{},"The marker sits above the text. A bridge gets its own paragraph.",[110,213,214,217],{},[125,215,216],{},"Inline after",[125,218,219],{},"The marker follows the text on the same line.",[110,221,222,225],{},[125,223,224],{},"Inline before",[125,226,227],{},"The marker leads the text on the same line.",[95,229,230],{},"An empty bridge is a blank line, or a single space when the marker is inline. A bridge you type shows up immediately. You do not have to edit the source or change the placement first.",[95,232,233,234,237],{},"Inline posts join the bridge as a space, the bridge, and a space: ",[131,235,236],{},"${bridge}",".",{"title":239,"searchDepth":240,"depth":240,"links":241},"",2,[242,243],{"id":101,"depth":240,"text":102},{"id":181,"depth":240,"text":182},"How counters and the custom bridge are written into each post.","md",null,{},true,{"title":32,"description":244},"kvNKbLRKXjt979ggNAPAGX2NeURcVRbGY8hr2cOYshc",[252,254],{"title":28,"path":29,"stem":30,"description":253,"children":-1},"The four character limits and what changes when you switch.",{"title":36,"path":37,"stem":38,"description":255,"children":-1},"Capitalize posts, finish sentences, and keep line breaks.",1792868107566]