],{},"PostList",[99,184,185],{},"PostCard",[137,187,188],{},"Read each post, reorder it, copy it, or drop it.",[119,190,191,194,199],{},[137,192,193],{},"Ship station",[137,195,196],{},[99,197,198],{},"ShipStation",[137,200,201],{},"See the totals, copy the sequence, or download Markdown.",[119,203,204,207,212],{},[137,205,206],{},"QR",[137,208,209],{},[99,210,211],{},"QrModal",[137,213,214],{},"Scan one post onto a phone.",[119,216,217,220,225],{},[137,218,219],{},"Footer",[137,221,222],{},[99,223,224],{},"WeaverFooter",[137,226,227],{},"The offline note.",[108,229,231],{"id":230},"a-normal-pass","A normal pass",[233,234,235,239,242,245,248],"ol",{},[236,237,238],"li",{},"Leave the sample sentence or replace it.",[236,240,241],{},"Pick the platform. The character ring uses that platform's limit.",[236,243,244],{},"Set the marker and, if you want one, the bridge.",[236,246,247],{},"Turn on a text tool only when you want that change.",[236,249,250],{},"Copy a card, copy the whole sequence, or download the Markdown file.",[95,252,253],{},"Clear empties the box. The page then shows one empty card so the marker still has a place to sit.",{"title":255,"searchDepth":256,"depth":256,"links":257},"",2,[258,259],{"id":110,"depth":256,"text":111},{"id":230,"depth":256,"text":231},"The parts of the page and what each one is for.","md",null,{},true,{"title":24,"description":260},"uycOhnPkap-oU2ZV-3UMCjo8MTW_mfzruyfm5yVvWvs",[268,270],{"title":14,"path":15,"stem":16,"description":269,"children":-1},"Run Thread Weaver locally with Bun.",{"title":28,"path":29,"stem":30,"description":271,"children":-1},"The four character limits and what changes when you switch.",1792868107742]