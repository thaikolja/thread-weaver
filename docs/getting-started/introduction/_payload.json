[{"data":1,"prerenderedAt":150},["ShallowReactive",2],{"navigation_docs":3,"-getting-started-introduction":85,"-getting-started-introduction-surround":147},[4,18,43,60],{"title":5,"path":6,"stem":7,"children":8,"page":17},"Getting Started","\u002Fgetting-started","1.getting-started",[9,13],{"title":10,"path":11,"stem":12},"Introduction","\u002Fgetting-started\u002Fintroduction","1.getting-started\u002F1.introduction",{"title":14,"path":15,"stem":16},"Installation","\u002Fgetting-started\u002Finstallation","1.getting-started\u002F2.installation",false,{"title":19,"path":20,"stem":21,"children":22,"page":17},"Using The Tool","\u002Fusing-the-tool","2.using-the-tool",[23,27,31,35,39],{"title":24,"path":25,"stem":26},"The workbench","\u002Fusing-the-tool\u002Fworkbench","2.using-the-tool\u002F1.workbench",{"title":28,"path":29,"stem":30},"Platforms","\u002Fusing-the-tool\u002Fplatforms","2.using-the-tool\u002F2.platforms",{"title":32,"path":33,"stem":34},"Markers and bridges","\u002Fusing-the-tool\u002Fmarkers-and-bridges","2.using-the-tool\u002F3.markers-and-bridges",{"title":36,"path":37,"stem":38},"Text tools","\u002Fusing-the-tool\u002Ftext-tools","2.using-the-tool\u002F4.text-tools",{"title":40,"path":41,"stem":42},"Shipping a thread","\u002Fusing-the-tool\u002Fshipping","2.using-the-tool\u002F5.shipping",{"title":44,"path":45,"stem":46,"children":47,"page":17},"Architecture","\u002Farchitecture","3.architecture",[48,52,56],{"title":49,"path":50,"stem":51},"Overview","\u002Farchitecture\u002Foverview","3.architecture\u002F1.overview",{"title":53,"path":54,"stem":55},"Page and state","\u002Farchitecture\u002Fpage-and-state","3.architecture\u002F2.page-and-state",{"title":57,"path":58,"stem":59},"Splitting","\u002Farchitecture\u002Fsplitting","3.architecture\u002F3.splitting",{"title":61,"path":62,"stem":63,"children":64,"page":17},"Reference","\u002Freference","4.reference",[65,69,73,77,81],{"title":66,"path":67,"stem":68},"Types and limits","\u002Freference\u002Ftypes-and-limits","4.reference\u002F1.types-and-limits",{"title":70,"path":71,"stem":72},"Splitting and compile","\u002Freference\u002Fsplitting-and-compile","4.reference\u002F2.splitting-and-compile",{"title":74,"path":75,"stem":76},"State and metrics","\u002Freference\u002Fstate-and-metrics","4.reference\u002F3.state-and-metrics",{"title":78,"path":79,"stem":80},"Composables","\u002Freference\u002Fcomposables","4.reference\u002F4.composables",{"title":82,"path":83,"stem":84},"Components","\u002Freference\u002Fcomponents","4.reference\u002F5.components",{"id":86,"title":10,"body":87,"description":140,"extension":141,"links":142,"meta":143,"navigation":144,"path":11,"seo":145,"stem":12,"__hash__":146},"docs\u002F1.getting-started\u002F1.introduction.md",{"type":88,"value":89,"toc":133},"minimark",[90,94,98,103,106,110,113,121,125],[91,92,10],"h1",{"id":93},"introduction",[95,96,97],"p",{},"A long post is hard to read on a timeline. Thread Weaver splits that post into a sequence of shorter posts before you publish it.",[99,100,102],"h2",{"id":101},"who-it-is-for","Who it is for",[95,104,105],{},"Use it when you already have the words and you need them to fit a character limit. The tool is a workbench, not a social network. It does not sign you in, and it does not keep a history of what you wrote.",[99,107,109],{"id":108},"what-stays-on-your-machine","What stays on your machine",[95,111,112],{},"Splitting, markers, totals, and the download file are computed in the page. Copy uses the browser clipboard. Listen uses the browser speech API. Send opens the platform's compose page in a new tab and leaves the actual post to you.",[95,114,115,116,120],{},"The only remote call is the QR image. Send to Phone asks ",[117,118,119],"code",{},"api.qrserver.com"," for a picture of the current post. Everything else stays local.",[99,122,124],{"id":123},"version","Version",[95,126,127,128,132],{},"The project is version ",[129,130,131],"strong",{},"1.0.0",". That number stays until the maintainer asks for a bump. It is not a production release yet.",{"title":134,"searchDepth":135,"depth":135,"links":136},"",2,[137,138,139],{"id":101,"depth":135,"text":102},{"id":108,"depth":135,"text":109},{"id":123,"depth":135,"text":124},"What Thread Weaver does, and what it deliberately does not do.","md",null,{},true,{"title":10,"description":140},"rF3rga0GhAWK90CBscltMmg2AHOOvUgpw3Bjaosh0l4",[142,148],{"title":14,"path":15,"stem":16,"description":149,"children":-1},"Run Thread Weaver locally with Bun.",1792868107566]