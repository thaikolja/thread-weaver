{
  "name": "weaver.yanawa.io",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "bun scripts/ensure-docs.mjs && nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "deploy:preview": "bun scripts/deploy-cloudflare.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "test": "bun test",
    "test:vitest": "vitest run",
    "typecheck": "nuxt typecheck",
    "docs:generate": "bun scripts/generate-docs.mjs",
    "docs:dev": "bun scripts/generate-docs.mjs && bun --cwd docs dev",
    "docs:preview": "bun --cwd docs preview",
    "docs:build": "bun scripts/generate-docs.mjs && bun --cwd docs generate",
    "build:site": "bun run docs:build && bun run generate && bun scripts/mount-docs.mjs"
  },
  "dependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/icon": "^2.6.2",
    "@nuxt/image": "^2.2.1",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/seo": "6.0.1",
    "@vueuse/nuxt": "15.0.0",
    "nuxt": "^4.6.4",
    "nuxt-qrcode": "0.4.10",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "10.14.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "happy-dom": "^21.0.4",
    "simple-analytics-vue": "^3.1.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "vue-tsc": "3.3.13",
    "wrangler": "^4.156.2"
  },
  "packageManager": "bun",
  "overrides": {
    "@nuxt/fonts": "^1.2.0",
    "typescript": "^5.9.3"
  }
}
