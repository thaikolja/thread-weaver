{
  "name": "weaver.yanawa.io",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "test": "vitest",
    "typecheck": "nuxt typecheck",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "docs:generate": "bun scripts/generate-docs.mjs",
    "docs:dev": "bun --cwd documentation dev",
    "docs:build": "bun scripts/generate-docs.mjs && bun --cwd documentation generate"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/simple-icons": "^1.2.100",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/fonts": "^1.0.0",
    "@nuxt/hints": "1.1.5",
    "@nuxt/icon": "2.6.0",
    "@nuxt/image": "2.2.0",
    "@nuxt/scripts": "1.3.12",
    "@nuxt/test-utils": "4.3.4",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/seo": "6.0.1",
    "@vueuse/nuxt": "15.0.0",
    "nuxt": "^4.6",
    "nuxt-auth-utils": "0.5.32",
    "nuxt-authorization": "0.3.5",
    "playwright": "1.64.1",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "latest",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "latest",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "happy-dom": "^21.0.4",
    "typescript": "latest",
    "vitest": "^5.0.5",
    "vue-tsc": "latest"
  },
  "packageManager": "bun@latest",
  "overrides": {
    "@nuxt/fonts": "^1.1.0"
  }
}
